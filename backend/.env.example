# Database (MongoDB Atlas)
MONGO_URL="mongodb+srv://<username>:<password>@<cluster-url>/?appName=<app-name>"
DB_NAME="faculty_hub"

# CORS Configuration (Comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"

# Link to Frontend
FRONTEND_URL="http://localhost:3000"

# OpenAlex API (Research Works)
OPENALEX_API_KEY="YOUR_OPENALEX_API_KEY"

# Admin Credentials
ADMIN_EMAIL=your-admin-email@vitapstudent.ac.in
ADMIN_PASSWORD=your-admin-password

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASSWORD=your-smtp-password